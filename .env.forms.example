# HTTPS endpoint of your form delivery / CRM service.
# The service should acknowledge only successfully stored or delivered requests.
FORM_WEBHOOK_URL=
# Optional bearer token. Keep this server-side; never use a VITE_ prefix.
FORM_WEBHOOK_TOKEN=

# Partner applications use SMTP when SMTP_HOST is configured.
# Port 587 requires STARTTLS. Keep every setting server-side.
SMTP_HOST=mta.useinbox.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=bilgilendirme@footbalance.com.tr
PARTNER_FORM_TO=dgn.ugur@gmail.com
# Optional; uses PARTNER_FORM_TO when empty.
INTERVIEW_FORM_TO=

# Persistent Ubuntu directory OUTSIDE application releases and public/.
LEADS_DATA_DIR=/var/lib/footbalance/leads
LEADS_REPORT_TO=dgn.ugur@gmail.com

# Generate a random secret (at least 32 characters); keep server-side.
LEADS_DOWNLOAD_SECRET=
LEADS_REPORT_BASE_URL=https://footbalance.ugurdogan.net
